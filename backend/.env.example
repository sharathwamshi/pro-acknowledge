# Copy to .env and adjust for your server.

# --- Database ---
# SQLite (simplest; fine for an internal team):
DATABASE_URL=sqlite:////var/lib/acknowledger/acknowledger.db
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+psycopg://ack:password@localhost:5432/acknowledger

# --- Auth ---
# Generate a long random string, e.g.:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE-ME-to-a-long-random-string
JWT_EXPIRE_HOURS=12

# --- CORS ---
# "*" is fine here: the extension and agent are cross-origin and auth is a
# bearer token, not cookies. To lock it down to just the web app instead:
# CORS_ORIGINS=https://proafpl.anametaiot.com
CORS_ORIGINS=*
